# Local development defaults, read by src/data-source.ts when the variables are not already set.
# They match the container started with the command in the README ("Local development").
# In Kubernetes the same variables are injected from a Secret; this file is not in the image.
TYPEORM_HOST = localhost
TYPEORM_PORT = 3306
TYPEORM_USERNAME = test
TYPEORM_PASSWORD = test
TYPEORM_DATABASE = test
