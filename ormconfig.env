# Local development defaults (docker run ... mariadb, see README).
# In Kubernetes these same TYPEORM_* variables are injected from a ConfigMap/Secret;
# when TYPEORM_CONNECTION is present in the environment this file is not used.
TYPEORM_CONNECTION = mysql
TYPEORM_HOST = localhost
TYPEORM_PORT = 3306
TYPEORM_USERNAME = test
TYPEORM_PASSWORD = test
TYPEORM_DATABASE = test
# Never let the ORM alter the schema on its own: schema changes go through migrations.
TYPEORM_SYNCHRONIZE = false
TYPEORM_ENTITIES = src/entity/*.js
TYPEORM_SUBSCRIBERS = src/subscriber/*.js
TYPEORM_MIGRATIONS = src/migration/*.js
TYPEORM_ENTITIES_DIR = src/entity
TYPEORM_MIGRATIONS_DIR = src/migration
TYPEORM_SUBSCRIBERS_DIR = src/subscriber
